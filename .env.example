# Variable NAMES only. Never commit values. Copy to `.env` (git-ignored) to override locally.
# Read by src/config/env.ts. Absent or anything other than PROD → UAT.
# PROD (approved 2026-11-11, iOS-9b) is for release builds of the `production` EAS profile only: a development build
# refuses it, and the build guard refuses it on every other profile. Leave this empty locally (UAT).
EXPO_PUBLIC_APP_ENV=

# Microsoft Entra ID, mobile public-client app registration (ask A2). Read by src/config/auth.config.ts.
# IDs, not secrets. EAS builds don't upload .env: for an APK, fill the defaults in auth.config.ts instead.
# There is no client secret, and there must never be one.
EXPO_PUBLIC_AZURE_CLIENT_ID=
EXPO_PUBLIC_AZURE_TENANT_ID=
