{
  "expo": {
    "name": "Mount Meru Service Desk",
    "slug": "meru-servicedesk",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": [
      "mmgservicedesk",
      "com.mountmeru.servicedesk",
      "msauth"
    ],
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.mountmeru.servicedesk",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 192,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D51B28"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "86788b11-328a-4ad7-a3dc-275b6f31325e"
      }
    },
    "owner": "ronitpc"
  }
}
