node_modules/

# Expo
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# Native projects are generated by `expo prebuild` / EAS — never committed
android/
ios/

# Build artefacts
*.apk
*.aab
*.ipa
*.hprof
build/
.gradle/
.cxx/
*.tsbuildinfo

# Signing material — never commit (08-SDP-PARITY §8.2: upload key lives in a secret store)
*.keystore
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
google-services.json
GoogleService-Info.plist

# Environment files — every variant ignored; only .env.example (names only) is committed
.env
.env.*
*.env
!.env.example

# Metro / logs
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
