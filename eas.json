// EAS Build profiles (JSON5: comments are allowed in eas.json). How to build, sign and distribute: docs/RELEASE.md.
// Every profile sets EXPO_PUBLIC_APP_ENV, which src/config/env.ts turns into the API base URL. No URL lives here.
// scripts/eas-build-guard.js runs first on the build server and refuses a production build while the PROD URL in
// src/config/env.ts is empty, and refuses PROD on any other profile.
{
  "cli": {
    "version": ">= 24.8.0",
    // app.json is the source of truth for version and android.versionCode; bump them by hand for each release.
    "appVersionSource": "local"
  },
  "build": {
    // Dev client for day-to-day development against UAT. Needs expo-dev-client, which is NOT installed yet (it is on
    // the approval list in docs/RELEASE.md); until then use `npx expo start` for development.
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_APP_ENV": "UAT" }
    },
    // Installable APK for testers, pointed at UAT. This is the first build to run.
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_APP_ENV": "UAT" }
    },
    // ⛔ PLACEHOLDER — NOT RUNNABLE. Ronit has not approved a production URL: the PROD entry in src/config/env.ts is
    // empty, so the build guard stops this profile on the server, and the app itself refuses to start without it.
    // Do not use until every item of the pre-release checklist in docs/RELEASE.md is done.
    "production": {
      "distribution": "store",
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_APP_ENV": "PROD" }
    }
  }
}
