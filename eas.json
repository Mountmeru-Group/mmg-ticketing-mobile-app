// EAS Build profiles for the iOS app (JSON5: comments are allowed in eas.json). No build is run in iOS-1b; the first
// one is iOS-3 (docs/ios/00-PORT-MANIFEST.md §2).
// Every profile sets EXPO_PUBLIC_APP_ENV, which src/config/env.ts turns into the API base URL. No URL lives here.
// scripts/eas-build-guard.js runs first on the build server and refuses a production build while the PROD URL in
// src/config/env.ts is empty, and refuses PROD on any other profile.
{
  "cli": {
    "version": ">= 24.8.0",
    // app.json is the source of truth for version and ios.buildNumber; bump them by hand for each upload.
    "appVersionSource": "local"
  },
  "build": {
    // TestFlight build for internal testers, pointed at UAT. Store-signed, because TestFlight requires it.
    // The channel takes effect once expo-updates is added (iOS-3).
    "preview": {
      "node": "24.18.0",
      "distribution": "store",
      "channel": "ios-preview",
      "env": { "EXPO_PUBLIC_APP_ENV": "UAT" }
    },
    // ⛔ PLACEHOLDER — NOT RUNNABLE. Ronit has not approved a production URL: the PROD entry in src/config/env.ts is
    // empty, so the build guard stops this profile on the server, and the app itself refuses to start without it.
    // Do not use until docs/ios/APP-STORE-COMPLIANCE.md is closed for release (iOS-9).
    "production": {
      "node": "24.18.0",
      "distribution": "store",
      "channel": "production",
      "env": { "EXPO_PUBLIC_APP_ENV": "PROD" }
    }
  }
}
