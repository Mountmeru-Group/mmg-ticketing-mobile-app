// EAS Build profiles for the iOS app (JSON5: comments are allowed in eas.json). No build is run in iOS-1b; the first
// one is iOS-7 (docs/ios/00-PORT-MANIFEST.md §2).
// Every profile sets EXPO_PUBLIC_APP_ENV, which src/config/env.ts turns into the API base URL. No URL lives here.
// scripts/eas-build-guard.js runs first on the build server: it refuses PROD on any profile but production, and a
// production build without the PROD URL (src/config/env.ts) or the privacy and support links (src/config/legal.ts).
{
  "cli": {
    "version": ">= 24.8.0",
    // EAS keeps the build number (iOS-7a): each preview build gets the next one (build.preview.ios.autoIncrement).
    // The user-facing version stays app.json's "version"; its ios.buildNumber only seeds EAS's counter once.
    "appVersionSource": "remote"
  },
  "build": {
    // TestFlight build for internal testers, pointed at UAT. Store-signed, because TestFlight requires it.
    // expo-updates is installed (iOS-7a): updates to this channel follow docs/ios/RELEASE-IOS.md (fixes only).
    "preview": {
      "node": "24.18.0",
      "distribution": "store",
      "channel": "ios-preview",
      "env": { "EXPO_PUBLIC_APP_ENV": "UAT" },
      "ios": { "autoIncrement": true }
    },
    // The App Store build (iOS-9b), pointed at PROD: approved by Ronit's manager on 2026-11-11, for this profile only.
    // Version 1.0.0 (app.json); EAS gives each build the next build number. Its channel is `production` and never
    // ios-preview, so a TestFlight (UAT) update can't reach it. Build, submit and update rules: docs/ios/RELEASE-IOS.md.
    "production": {
      "node": "24.18.0",
      "distribution": "store",
      "channel": "production",
      "env": { "EXPO_PUBLIC_APP_ENV": "PROD" },
      "ios": { "autoIncrement": true }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "ascAppId": "6827931735",
        "appleTeamId": "ZNPR2MFW76"
      }
    },
    // The same App Store Connect app as preview: submit a production build by its own build (`--auto-submit` or
    // `--id`), never `--latest`, which takes the newest iOS build of EITHER profile (RELEASE-IOS.md §4).
    "production": {
      "ios": {
        "ascAppId": "6827931735",
        "appleTeamId": "ZNPR2MFW76"
      }
    }
  }
}
