// EAS Build profiles (JSON5: comments are allowed in eas.json). How to build, sign and distribute: docs/RELEASE.md.
// No profile chooses the API environment (2026-11-17): the person chooses it in the app (Login → gear), and every
// release build starts on Production. No URL and no EXPO_PUBLIC_APP_ENV live here: scripts/eas-build-guard.js runs
// first on the build server and refuses a build that sets EXPO_PUBLIC_APP_ENV, or one whose env.ts lacks a URL.
{
  "cli": {
    "version": ">= 24.8.0",
    // app.json is the source of truth for version and android.versionCode; bump them by hand for each release.
    "appVersionSource": "local"
  },
  "build": {
    // Installable APK for testers. Starts on Production like every release build: testers switch to UAT once, on
    // Login's gear, and the app keeps that choice.
    "preview": {
      "node": "24.18.0",
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    // Store AAB for Google Play. Check the pre-release checklist in docs/RELEASE.md §5 before every build of this profile.
    "production": {
      "node": "24.18.0",
      "distribution": "store",
      "android": { "buildType": "app-bundle" }
    }
  }
}
